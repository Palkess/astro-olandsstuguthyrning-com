---
/**
 * Contact page. The old site had no working way to reach Helen and Lars at all
 * — both numbers lived inside commented-out markup — so this page and the
 * footer together are the fix for the biggest content bug found (plan D2).
 *
 * The map tile is a static image (`LocationMap.astro`), not an embed: a Google
 * or Mapbox map would be a third-party request before consent, on the page
 * whose neighbour is a privacy policy promising we make none.
 */
import InfoCard from '../molecules/InfoCard.astro';
import LocationMap from '../molecules/LocationMap.astro';
import { site } from '../../data/site';
import { interpolate, useTranslations, type Locale } from '../../i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="mx-auto max-w-360 px-5 py-12 lg:px-12 lg:py-18">
    <div class="max-w-225">
        <h1 class="font-serif text-h1 mt-0 mb-4 font-normal">{t.contact.heading}</h1>
        <p class="text-lead m-0 max-w-[60ch]">{t.contact.intro}</p>
    </div>

    <div class="mt-9 grid gap-5 lg:grid-cols-2">
        {
            /*
             * `lg:flex-auto` on each card, not `flex-1`: above `lg` the map sets the
             * row height, and these three share whatever it leaves over so the column
             * ends flush with it instead of stopping short. Tailwind's `flex-1` is
             * `flex: 1 1 0%`, which would throw the content heights away and cut the
             * column into equal thirds — the one-line email card would end up as tall
             * as the two-number phone card. `flex-auto` keeps each card's own height
             * as the basis and only shares out the surplus.
             *
             * It is a no-op when the left column is the taller of the two, and below
             * `lg` each column is its own grid row, so there is no surplus to share.
             */
        }
        <div class="flex min-w-0 flex-col gap-5">
            <InfoCard label={t.contact.phoneHeading} class="lg:flex-auto">
                <ul class="m-0 flex list-none flex-col gap-3 p-0">
                    {
                        site.phones.map((phone) => (
                            <li>
                                <a
                                    href={`tel:${phone.tel}`}
                                    class="text-accent hover:text-accent-hover text-[1.375rem]/[1.3]
                                        font-semibold no-underline">
                                    {phone.display}
                                </a>
                                <div class="text-small">
                                    {interpolate(t.contact.callName, { name: phone.name })}
                                </div>
                            </li>
                        ))
                    }
                </ul>
                <p class="text-text-muted mt-4 mb-0 text-small">{t.contact.languagesNote}</p>
            </InfoCard>

            <InfoCard label={t.contact.emailHeading} class="lg:flex-auto">
                {
                    /*
                     * `wrap-anywhere`, not `break-words`: `overflow-wrap: break-word`
                     * doesn't feed back into intrinsic sizing, so the unbroken
                     * address set this grid column's min-content width and the whole
                     * page scrolled sideways on a 390px screen. Stepping the size up
                     * only from `sm` means it never actually has to break.
                     */
                }
                <a
                    href={`mailto:${site.email}`}
                    class="text-accent hover:text-accent-hover text-body wrap-anywhere
                        font-semibold no-underline sm:text-h4">
                    {site.email}
                </a>
            </InfoCard>

            <InfoCard label={t.contact.addressHeading} class="lg:flex-auto">
                <address class="not-italic">
                    {site.name}<br />
                    {site.owners.join(' & ')}<br />
                    {site.location.village}, {site.location.island}
                </address>
                <p class="bg-surface-sunken rounded-button mt-4 mb-0 px-4 py-3.5 text-small">
                    {t.contact.directionsNote}
                </p>
            </InfoCard>
        </div>

        <div class="flex min-w-0 flex-col gap-5">
            <div class="border-border bg-card rounded-card overflow-hidden border">
                {
                    /*
                     * Full-bleed: the map spans the card, and the card's
                     * `overflow-hidden` clips its top corners. `LocationMap`'s
                     * `sizes` hint is written against this column's width — if the
                     * grid below changes, that hint changes with it.
                     */
                }
                <LocationMap locale={locale} />
                <p class="border-border text-text-muted m-0 border-t px-5 py-3.5 text-small">
                    {t.contact.mapCaption}
                </p>
            </div>
        </div>
    </div>
</div>
