---
/**
 * Birdwatching page. Its job is the PDF download — the species list Helen and
 * Lars keep for the village. The file name is preserved from the old site
 * because it is a link people have shared.
 */
import { Picture } from 'astro:assets';
import { Download } from '@lucide/astro';

import SectionLabel from '../atoms/SectionLabel.astro';
import { useTranslations, type Locale } from '../../i18n';

import birdImage from '../../assets/images/birdwatching-lot.jpg';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const pdfHref = '/Observerade-faglar-i-Lot.pdf';
---

<Picture
    src={birdImage}
    alt={t.birdwatching.imageAlt}
    formats={['avif', 'webp']}
    widths={[600, 1000, 1600, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="aspect-3/2 w-full object-cover sm:aspect-[21/9] lg:aspect-auto lg:h-[420px]"
/>

<div
    class="mx-auto grid max-w-[1440px] items-start gap-10 px-5 py-12 lg:grid-cols-[1fr_420px]
        lg:gap-16 lg:px-12 lg:py-16">
    <div class="max-w-[68ch]">
        <SectionLabel>{t.birdwatching.label}</SectionLabel>
        <h1 class="font-serif text-h1 mt-3.5 mb-5 font-normal">{t.birdwatching.heading}</h1>
        <p class="text-lead mt-0 mb-5">{t.birdwatching.intro}</p>
        {t.birdwatching.body.map((paragraph) => <p class="mb-4 last:mb-0">{paragraph}</p>)}
    </div>

    <div class="border-border bg-card rounded-card border p-6">
        <h2 class="text-text-heading text-h4 mt-0 mb-2.5 font-semibold">
            {t.birdwatching.pdfHeading}
        </h2>
        <p class="mt-0 mb-5">{t.birdwatching.pdfBody}</p>

        <a
            href={pdfHref}
            download
            class="bg-accent text-accent-contrast hover:bg-accent-hover rounded-button flex
                items-center justify-center gap-2.5 px-5 py-4 font-semibold no-underline">
            {t.birdwatching.downloadCta}
            <Download size={18} stroke-width={1.8} aria-hidden="true" />
        </a>

        <p class="text-text-muted mt-3 mb-0 text-small">{t.birdwatching.pdfMeta}</p>
    </div>
</div>
