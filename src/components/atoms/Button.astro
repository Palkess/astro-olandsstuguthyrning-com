---
/**
 * The site's three button treatments, from the design session.
 *
 * `primary` is the booking CTA and its siblings; `secondary` is the paired
 * neutral action; `link` is the inline "Se stugan →" affordance.
 *
 * Labels are never truncated and never centred in a fixed-width box: German
 * runs ~30% longer than Swedish ("Jetzt auf Stugknuten buchen"), and the design
 * resolves that by letting the button grow and wrap rather than clip.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
    href: string;
    variant?: 'primary' | 'secondary' | 'link';
    /** Adds `target="_blank"` + `rel` and is announced to screen readers. */
    external?: boolean;
    /** Stretches to the container width — the mobile stacked-CTA pattern. */
    full?: boolean;
}

const {
    href,
    variant = 'primary',
    external = false,
    full = false,
    class: className,
    ...rest
} = Astro.props;

const base =
    'inline-flex items-center gap-2.5 font-sans font-semibold transition-colors ' +
    'no-underline text-balance';

const variants = {
    primary:
        'justify-center rounded-button bg-accent px-6 py-[17px] text-[1.0625rem]/[1.3] ' +
        'text-accent-contrast hover:bg-accent-hover',
    secondary:
        'justify-center rounded-button border-[1.5px] border-border-strong px-[22px] ' +
        'py-[15.5px] text-[1.0625rem]/[1.3] text-text-heading hover:border-text-heading ' +
        'hover:bg-surface-sunken',
    link:
        'border-b-[1.5px] border-accent py-1.5 text-base text-accent ' +
        'hover:border-accent-hover hover:text-accent-hover'
} as const;

const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
    href={href}
    class:list={[base, variants[variant], full && 'w-full', className]}
    {...externalAttrs}
    {...rest}>
    <slot />
</a>
