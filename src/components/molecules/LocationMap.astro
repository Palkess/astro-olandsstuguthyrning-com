---
/**
 * An orientation map: where Öland is, and where Löt sits on it.
 *
 * A static raster extract, replacing the hand-drawn schematic SVG that stood
 * here before — ADR-019 reverses ADR-014. It is an *image*, not an embed: no
 * tile server is contacted at runtime, so the contact page still makes no
 * third-party request before consent, which is what the privacy policy on the
 * page next to it promises. Do not "upgrade" this to Leaflet or a Google embed
 * to get pan and zoom; that trade was declined twice.
 *
 * The extract is OpenStreetMap data, which is ODbL. The credit under the image
 * is a licence condition, not decoration — it must stay visible, and it lives
 * in this component rather than in the caller's caption row so that the two
 * cannot drift apart if the tile is ever rearranged or reused.
 *
 * The image is full-bleed inside its card: no border or radius of its own, so
 * the card's `overflow-hidden` clips the top corners. `sizes` therefore tracks
 * the *card* width — one of the two contact-page grid columns above `lg`, the
 * full container below it. Change that grid and this hint has to follow, or the
 * browser picks a candidate too small and the map's place names go soft.
 */
import { Picture } from 'astro:assets';

import mapImage from '../../assets/images/location-map-oland.jpg';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
    locale: Locale;
    class?: string;
}

const { locale, class: className } = Astro.props;

const t = useTranslations(locale);
---

<figure class:list={['m-0', className]}>
    <Picture
        src={mapImage}
        alt={t.contact.mapAlt}
        formats={['avif', 'webp']}
        widths={[400, 700, 1104]}
        sizes="(min-width: 1024px) 41rem, calc(100vw - 2.5rem)"
        loading="lazy"
        class="block h-auto w-full"
    />
    <figcaption class="text-text-muted px-5 pt-2.5 pb-3 text-label">
        <a
            href="https://www.openstreetmap.org/copyright"
            target="_blank"
            rel="noopener"
            class="text-text-muted underline">
            {t.contact.mapAttribution}
        </a>
    </figcaption>
</figure>
