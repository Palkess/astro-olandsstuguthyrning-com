---
/** Swedish home page — `/`. */
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/pages/HomePage.astro';
import { useTranslations } from '../i18n';
import { businessSchema, siteOgImage, siteOgImageAlt } from '../lib/seo';

const locale = 'sv' as const;
const t = useTranslations(locale);

const jsonLd = [await businessSchema(locale, Astro.site)];
---

<Layout
    {locale}
    routeKey="home"
    title={`${t.meta.homeTitle} | ${t.meta.titleSuffix}`}
    description={t.meta.homeDescription}
    ogImage={await siteOgImage()}
    ogImageAlt={siteOgImageAlt(locale)}
    {jsonLd}>
    <HomePage {locale} />
</Layout>
